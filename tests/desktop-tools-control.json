{
  "tools": [
    {
      "name": "App",
      "title": "App",
      "description": "Open/start/launch applications and manage windows. Keywords: open, start, launch, program, application, window, foreground, focus, resize. Four modes: 'launch' (opens an application by Start Menu name), 'launch_executable' (strictly launches one executable path with separated argv and optional cwd), 'resize' (adjusts a named or active window), and 'switch' (brings a specific window into focus).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "default": "launch",
            "enum": [
              "launch",
              "launch_executable",
              "resize",
              "switch"
            ],
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "window_loc": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "window_size": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "executable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "args": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "title": "App",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
